{
	"extends": ["github>MarioMH8/renovate-config"],
	"hostRules": [
		{
			"matchHost": "https://npm.pkg.github.com/",
			"hostType": "npm",
			"token": "{{ secrets.RENOVATE_PACKAGES_TOKEN }}"
		}
	],
	"npmrc": "@mariomh8:registry=https://npm.pkg.github.com/",
	"packageRules": [
		{
			"matchPackageNames": ["@mariomh8/**"],
			"minimumReleaseAge": null
		},
		{
			"matchPackageNames": ["@mariomh8/*"],
			"groupName": "@mariomh8 monorepo"
		}
	]
}
